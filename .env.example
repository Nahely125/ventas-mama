# Copia este archivo como .env y completa los valores.

# Clave larga y aleatoria para firmar las sesiones (obligatoria).
SESSION_SECRET=

# Opción A: base de datos en la nube (Neon, Supabase...). Si existe, se usa esta.
# DATABASE_URL=postgresql://usuario:clave@servidor/ventas_mama?sslmode=require

# Opción B: base de datos local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ventas_mama
DB_USER=postgres
DB_PASSWORD=

# Puerto del servidor (el hosting lo define solo).
# PORT=3000

# Fotos en Cloudflare R2 (opcional, recomendado). Si faltan, las fotos se guardan en la base.
# Al configurarlas, las fotos que estén en la base se pasan solas a R2 al arrancar.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mil-deseos-fotos
# R2_URL_PUBLICA=https://pub-xxxxxxxx.r2.dev
